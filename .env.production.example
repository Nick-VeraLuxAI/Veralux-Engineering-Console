# VeraLux Engineering Console — production template (placeholders only).
# Copy to .env.production.local or inject via your secrets manager.
# Never commit real secrets.

NODE_ENV=production

# --- Required in production ---
ENGINEER_CONSOLE_SESSION_SECRET=<generate-32+-char-random-secret>
ENGINEER_CONSOLE_DB_PATH=/var/lib/veralux/engineer-console.db
ENGINEER_CONSOLE_AUDIT_CHAIN_SCOPE=prod-engineer-console-main

# Bootstrap admin (first init only, when operator table is empty)
ENGINEER_CONSOLE_ADMIN_EMAIL=ops@example.com
ENGINEER_CONSOLE_ADMIN_PASSWORD_HASH=<bcrypt-hash-not-plaintext>

# Do NOT set in production:
# ENGINEER_CONSOLE_TRUSTED_LOCAL_DEV=true
# ENGINEER_CONSOLE_AUTH_ENABLED=false

# --- Repository boundaries (recommended) ---
ENGINEER_CONSOLE_REPO_ROOTS=/srv/git

# --- Model provider ---
ENGINEER_CONSOLE_MODEL_PROVIDER=mock
# KIMI_API_KEY=<server-only-if-using-kimi>
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2-0711-preview

# --- Release enforcement (recommended after staging dry run) ---
ENGINEER_CONSOLE_RELEASE_GATES_ENABLED=true

# --- Deployment (admin-only execution; review JSON before enable) ---
ENGINEER_CONSOLE_DEPLOYMENT_PROFILES_JSON=[]
# Example shape (keep allowed:false until reviewed):
# ENGINEER_CONSOLE_DEPLOYMENT_PROFILES_JSON=[{"name":"staging","environmentName":"staging","strategy":"fixed_command","workingDirectory":"/srv/app","command":"./scripts/deploy-staging.sh","args":[],"allowed":false,"timeoutMs":600000}]

# --- Health checks (HTTP GET only; URLs from profile, not client) ---
ENGINEER_CONSOLE_HEALTH_CHECK_PROFILES_JSON=[]

# --- Scheduled backup retention (optional; used by npm run backup:db:verify) ---
# ENGINEER_CONSOLE_BACKUP_RETENTION_COUNT=14
# ENGINEER_CONSOLE_BACKUP_RETENTION_DAYS=30

# --- Encrypted + off-host backup (optional; npm run backup:db:secure) ---
# ENGINEER_CONSOLE_BACKUP_ENCRYPTION_MODE=none
# ENGINEER_CONSOLE_BACKUP_AGE_RECIPIENT=age1xxxxxxxx
# ENGINEER_CONSOLE_BACKUP_GPG_RECIPIENT=ops@example.com
# ENGINEER_CONSOLE_BACKUP_OFFHOST_MODE=none
# ENGINEER_CONSOLE_BACKUP_RSYNC_TARGET=backup@backup.internal:/srv/engineer-console/

# --- Backup alerting (optional; npm run backup:db:alert) ---
# ENGINEER_CONSOLE_BACKUP_ALERT_MODE=none
# ENGINEER_CONSOLE_BACKUP_ALERT_WEBHOOK_URL=https://hooks.example.com/your-endpoint-id
# ENGINEER_CONSOLE_BACKUP_ALERT_ON_SUCCESS=false
# ENGINEER_CONSOLE_INSTANCE_LABEL=prod-console-01
