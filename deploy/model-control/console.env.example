# Copy to ~/.veralux-engineering-console/model-control/console.env (chmod 600).
# NEVER commit the real file. Generate secrets with: openssl rand -hex 32
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
# Bearer token for /v1/*, /api/engineer-console/models*, /api/engineer-console/mcp
ENGINEER_CONSOLE_MODEL_API_KEY=<generate: openssl rand -hex 32>
ENGINEER_CONSOLE_SESSION_SECRET=<generate: openssl rand -hex 32>
# Separate DB so the service never migrates the operator dev DB
ENGINEER_CONSOLE_DB_PATH=/home/<user>/.veralux-engineering-console/model-control/console-service.db
ENGINEER_CONSOLE_MODEL_CONTROL_DIR=/home/<user>/.veralux-engineering-console/model-control
# Model used when a client sends model "default"/"auto"
ENGINEER_CONSOLE_MODEL_DEFAULT=deepseek-v4-flash
# Auto-load managed models when a chat request targets them
ENGINEER_CONSOLE_MODEL_AUTOLOAD=true
# Unload managed models after N idle minutes (0 = never)
ENGINEER_CONSOLE_MODEL_IDLE_UNLOAD_MINUTES=30
# Default free-VRAM headroom kept after a load (catalog entries may override per model)
ENGINEER_CONSOLE_GPU_RESERVE_MIB=4096
# Optional: JSON array of catalog entries that replace/extend the defaults
# ENGINEER_CONSOLE_MODEL_CATALOG_PATH=/home/<user>/.veralux-engineering-console/model-control/catalog.json
